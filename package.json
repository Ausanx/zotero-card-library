{
  "name": "zotero-card-library",
  "type": "module",
  "version": "0.1.1",
  "description": "EzRead-style local card library for Zotero 9",
  "config": {
    "addonName": "Zotero Card Library",
    "addonID": "zotero-card-library@zotero",
    "addonRef": "zcl",
    "addonInstance": "ZoteroCardLibrary",
    "prefsPrefix": "extensions.zotero.zcl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-account/zotero-card-library.git"
  },
  "author": "Zotero Card Library contributors",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit && node scripts/package-artifacts.mjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "mocha --import=tsx \"tests/**/*.test.ts\"",
    "package": "npm run build",
    "update-deps": "npm update --save",
    "test:zotero": "node tests/integration/run-zotero.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "jsdom": "^30.1.2",
    "jszip": "^3.10.2",
    "mocha": "^12.0.3",
    "prettier": "^3.7.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "engines": {
    "node": ">=22.8.0"
  }
}
